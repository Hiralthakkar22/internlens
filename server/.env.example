# Local MongoDB (Compass default). For Atlas, paste your connection string here.
MONGO_URI=mongodb://127.0.0.1:27017/internlens

# Any long random text. Never share it, never push .env to GitHub.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=5000

# Where the React app runs. Add your Vercel URL after deploy (comma separated).
CLIENT_ORIGIN=http://localhost:5173

# Set to production on Render
NODE_ENV=development
